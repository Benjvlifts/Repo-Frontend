  }
  const handleStatusChange = <span class="fstat-no" title="function not covered" >async (p</span>, st) =&gt; {
<span class="cstat-no" title="statement not covered" >    try { <span class="cstat-no" title="statement not covered" >await updateProjectStatus(p.id, st); <span class="cstat-no" title="statement not covered" >f</span>etchProjects() } catch {</span> /* silent */ }</span>
  }
  const handleAssign = withSubmit(<span class="fstat-no" title="function not covered" >async () =&gt; {</span>
<span class="cstat-no" title="statement not covered" >    if (form.employeeId) {</span>
      const emp = <span class="cstat-no" title="statement not covered" >employees.<span class="fstat-no" title="function not covered" >find(e</span> =&gt; <span class="cstat-no" title="statement not covered" >String(e.id) === String(form.employeeId))</span></span>
<span class="cstat-no" title="statement not covered" >      await assignEmployee(activeProj.id, form.employeeId, emp?.name ?? '')</span>
