  const handleDelete = <span class="fstat-no" title="function not covered" >async (p</span>) =&gt; {
<span class="cstat-no" title="statement not covered" >    if (!window.confirm(`¿Eliminar "${p.name}"?`)) <span class="cstat-no" title="statement not covered" >return</span></span>
