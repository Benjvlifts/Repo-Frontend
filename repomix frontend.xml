&nbsp;
  useEffect(() =&gt; { fetchProjects() }, [fetchProjects])
&nbsp;
  const fetchEmployees = <span class="fstat-no" title="function not covered" >async () =&gt; {</span>
<span class="cstat-no" title="statement not covered" >    try { <span class="cstat-no" title="statement not covered" >setEmployees(Array.isArray(await getEmployees()) ? await getEmployees() : []) }</span></span>
