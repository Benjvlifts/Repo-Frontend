              <span style={{ fontSize: '0.83rem', color: T.muted }}>
                Ya tienes cuenta?{' '}
                <Link to="/login" style={{
                  color: T.text, fontWeight: 600, textDecoration: 'none',
                  borderBottom: '1px solid #EAEAEA', paddingBottom: '1px',
                }}>
                  Inicia sesión
                </Link>
              </span>
            </div>

          </div>
        </div>
      </div>
    </>
