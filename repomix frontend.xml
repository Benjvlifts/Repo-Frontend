<span class="cstat-no" title="statement not covered" >    setFormError(null); <span class="cstat-no" title="statement not covered" >s</span>etModal('edit')</span>
  }
&nbsp;
  const openAssign = <span class="fstat-no" title="function not covered" >async (p</span>) =&gt; {
<span class="cstat-no" title="statement not covered" >    setActiveProj(p)</span>
<span class="cstat-no" title="statement not covered" >    setForm({ employeeId: p.assignedUserId ?? '' })</span>
<span class="cstat-no" title="statement not covered" >    setFormError(null)</span>
