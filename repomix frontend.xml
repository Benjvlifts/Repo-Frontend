          &lt;p style={{ margin:'4px 0 0', color:T.color.textSecondary, fontSize:14 }}&gt;Disponibilidad y asignación del equipo.&lt;/p&gt;
        &lt;/div&gt;
        &lt;div style={{ display:'flex', gap:10 }}&gt;
