<span class="cstat-no" title="statement not covered" >    setModal('assign')</span>
  }
&nbsp;
  const openNotes = <span class="fstat-no" title="function not covered" >async (p</span>) =&gt; {
<span class="cstat-no" title="statement not covered" >    setActiveProj(p); <span class="cstat-no" title="statement not covered" >s</span>etNewNote('')</span>
