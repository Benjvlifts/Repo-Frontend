  const withSubmit = (fn) =&gt; <span class="fstat-no" title="function not covered" >async (e</span>) =&gt; {
<span class="cstat-no" title="statement not covered" >    e?.preventDefault(); <span class="cstat-no" title="statement not covered" >s</span>etSubmitting(true); <span class="cstat-no" title="statement not covered" >s</span>etFormError(null)</span>
<span class="cstat-no" title="statement not covered" >    try { <span class="cstat-no" title="statement not covered" >await fn(); <span class="cstat-no" title="statement not covered" >c</span>loseModal(); <span class="cstat-no" title="statement not covered" >f</span>etchProjects() }</span></span>
